set(ENV{IRIS_FAULT} example)
get_filename_component(cti_dir "${CTI}" DIRECTORY)
get_filename_component(cti_name "${CTI}" NAME)
set(ENV{GENICAM_GENTL64_PATH} "${cti_dir}")
string(RANDOM LENGTH 12 cache_suffix)
set(cache_dir "${CMAKE_CURRENT_BINARY_DIR}/genapi-example-cache-${cache_suffix}")
file(MAKE_DIRECTORY "${cache_dir}")
set(ENV{GENICAM_CACHE_V3_5} "${cache_dir}")

function(check_example expected)
    execute_process(COMMAND "${FEATURES}" "${cti_name}" test-serial ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status STREQUAL "0" OR NOT output MATCHES "${expected}")
        message(FATAL_ERROR "Feature example failed with ${status}\n${output}\n${error}")
    endif()
endfunction()

check_example("AcquisitionControl" browse Root)
check_example("Trigger Selector" browse AcquisitionControl)
check_example("Width = 16" get Width)
check_example("Width = 48" set Width 48)
check_example("ExposureTime = 450" set ExposureTime 450)
check_example("ReverseX = true" set ReverseX 1)
check_example("DeviceUserID = iris-demo" set DeviceUserID iris-demo)
check_example("TriggerMode = On" --select TriggerSelector FrameStart set TriggerMode On)
check_example("TriggerSoftware pending" execute TriggerSoftware)
file(GLOB cache_entries "${cache_dir}/*.bin")
if(NOT cache_entries)
    message(FATAL_ERROR "GenApi did not populate GENICAM_CACHE_V3_5")
endif()
file(REMOVE_RECURSE "${cache_dir}")
